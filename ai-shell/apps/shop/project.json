{
  "name": "shop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/shop/src",
  "tags": [
    "scope:shop"
  ],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "defaultConfiguration": "production",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/shop/tsconfig.federation.json",
        "ssr": true
      },
      "configurations": {
        "production": {
          "target": "shop:esbuild:production"
        },
        "development": {
          "target": "shop:esbuild:development",
          "dev": true
        }
      }
    },
    "serve": {
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "shop:serve-original:development",
        "tsConfig": "apps/shop/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "shop:build"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shop:build",
        "port": 4200,
        "staticFilePath": "dist/apps/shop/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/shop",
        "browser": "apps/shop/src/main.ts",
        "polyfills": [
          "zone.js",
          "es-module-shims"
        ],
        "tsConfig": "apps/shop/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shop/public"
          }
        ],
        "styles": [
          "apps/shop/src/styles.css"
        ],
        "server": "apps/shop/src/main.server.ts",
        "ssr": {
          "entry": "apps/shop/src/server.ts"
        },
        "outputMode": "server",
        "security": {
          "allowedHosts": [
            "localhost"
          ]
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "dependsOn": [
        "api:serve"
      ],
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/shop/proxy.conf.json",
        "port": 4200
      },
      "configurations": {
        "production": {
          "buildTarget": "shop:esbuild:production"
        },
        "development": {
          "buildTarget": "shop:esbuild:development"
        }
      }
    }
  }
}